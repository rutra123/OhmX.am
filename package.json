{
  "name": "ohmx-am",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "serve:prod": "npm run build && npm run start",
    "seed": "npm run seed -w server",
    "db:reset": "npm run db:reset -w server",
    "import:normalize": "npm run import:normalize -w server --",
    "import:categories": "npm run import:categories -w server --",
    "test": "node scripts/run-tests.mjs",
    "test:known-gaps": "node scripts/run-tests.mjs --known-gaps",
    "test:server": "node scripts/run-tests.mjs --only=server",
    "test:client": "node scripts/run-tests.mjs --only=client",
    "typecheck": "npm run typecheck:all -w server && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "version:site": "node scripts/bump-site-version.mjs",
    "version:local": "node scripts/bump-local-site-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^8.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "playwright": "^1.59.1",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "nodemailer": "^8.0.9"
  }
}
