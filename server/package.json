{
  "name": "ohmx-am-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.prod.json",
    "typecheck:all": "tsc -p tsconfig.json --noEmit",
    "postbuild": "npm run sync:building-project-runtime-assets && node scripts/copy-prod-runtime-data.mjs",
    "sync:building-project-runtime-assets": "node scripts/sync-building-project-runtime-assets.mjs",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test": "node ../scripts/run-tests.mjs --only=server",
    "test:building-project-hydronics": "tsx --test src/utils/buildingProjectHydronics.test.ts",
    "test:building-project-central-supply": "tsx --test src/utils/buildingProjectCentralSupply.test.ts",
    "test:building-project": "tsx --test src/utils/buildingProject.test.ts",
    "test:building-project-topology": "tsx --test src/utils/buildingProjectTopology.test.ts",
    "test:building-project-advanced": "tsx --test src/utils/buildingProjectRoomAdvanced.test.ts",
    "test:building-project-integrity": "tsx --test src/utils/buildingProjectIntegrity.test.ts",
    "test:building-project-loads": "tsx --test src/utils/buildingProjectLoads.test.ts",
    "test:building-project-quick-loads": "tsx --test src/utils/buildingProjectQuickLoads.test.ts",
    "test:catalog-full-export": "tsx --test src/services/catalogFullExport.test.ts",
    "test:catalog-calculator-inference": "tsx --test src/services/catalogCalculatorInference.test.ts",
    "test:catalog-consolidation": "tsx --test src/cli/consolidateAutomationCategories.test.ts",
    "test:catalog-matcher": "tsx --test src/utils/catalogMatcher/*.test.ts",
    "test:engineering-configurator": "tsx --test src/utils/engineeringConfigurator/*.test.ts",
    "test:engineering-selection-persistence": "tsx --test src/utils/buildingProjectEngineeringSelection.test.ts src/utils/buildingProjectEngineeringSelectionSourceInvariants.test.ts",
    "test:building-project-load-revision": "tsx --test src/utils/buildingProjectLoadRevision.test.ts src/utils/buildingProjectLoadRevisionSourceInvariants.test.ts",
    "test:engineering-catalog-state-provider": "tsx --test src/utils/engineeringCatalogState.test.ts src/utils/engineeringCatalogStateSourceInvariants.test.ts",
    "test:building-project-engineering-orchestrator": "tsx --test src/utils/buildingProjectEngineeringOrchestrator/buildingProjectEngineeringOrchestrator.test.ts src/utils/buildingProjectEngineeringOrchestrator/buildingProjectEngineeringOrchestratorSourceInvariants.test.ts",
    "test:building-project-catalog-matching-orchestrator": "tsx --test src/utils/buildingProjectCatalogMatchingOrchestrator/buildingProjectCatalogMatchingOrchestrator.test.ts src/utils/buildingProjectCatalogMatchingOrchestrator/buildingProjectCatalogMatchingOrchestratorSourceInvariants.test.ts",
    "test:engineering-data-inventory": "tsx --test src/scripts/exportEngineeringDataInventory.test.ts",
    "export:engineering-data-inventory": "tsx src/scripts/exportEngineeringDataInventory.ts",
    "test:engineering-data-import": "tsx --test src/scripts/previewEngineeringDataImport.test.ts src/scripts/previewEngineeringDataImportV3.test.ts src/scripts/applyFanCoilRt41Profiles.test.ts src/scripts/setFanCoilProfileReadiness.test.ts",
    "preview:engineering-data-import": "tsx src/scripts/previewEngineeringDataImport.ts",
    "test:engineering-data-import-apply": "tsx --test src/scripts/applyEngineeringDataImport.test.ts",
    "apply:engineering-data-import": "tsx src/scripts/applyEngineeringDataImport.ts",
    "db:reset": "SEED_FORCE=1 tsx src/seed.ts --force",
    "categories:reset:legacy": "tsx src/cli/resetCategoriesFromLegacyCsv.ts",
    "categories:rebuild:main-fixed": "tsx src/cli/rebuildCatalogFromMainFixedCsv.ts",
    "categories:assign-subcategory-images": "tsx src/cli/assignSubcategoryImagesFromProducts.ts",
    "categories:fix-switches-structure": "tsx src/cli/fixSwitchesCategoryStructure.ts",
    "categories:compact": "tsx src/cli/compactCatalogCategories.ts",
    "categories:consolidate-automation": "node dist/cli/consolidateAutomationCategories.js",
    "import:normalize": "tsx src/cli/normalizeImportCsv.ts",
    "import:categories": "tsx src/cli/extractImportCategories.ts",
    "apply:rt41-fc-profiles": "tsx src/scripts/applyFanCoilRt41Profiles.ts",
    "apply:rt41-fc-values": "tsx src/scripts/applyEngineeringDataImportRt41Fc.ts",
    "apply:fc-profile-readiness": "tsx src/scripts/setFanCoilProfileReadiness.ts",
    "test:hydronic-bom": "tsx --test src/utils/hydronicBom/fanCoilHydronicBom.test.ts",
    "import:relationships": "tsx src/scripts/applyRelationshipsImport.ts",
    "test:relationships-import": "tsx --test src/scripts/applyRelationshipsImport.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
