      {
        "field": "substrateType",
        "questionType": "single_choice",
        "required": true
      },
      {
        "field": "floorCovering",
        "questionType": "single_choice",
        "required": true
      },
      {
        "field": "heatingPurpose",
        "questionType": "single_choice",
        "required": true
      },
      {
        "field": "insulationLevel",
        "questionType": "single_choice",
        "required": true
      },
      {
        "field": "budgetLevel",
        "questionType": "single_choice",
        "required": false,
        "default": "optimal"
      },
      {
        "field": "includeAccessories",
        "questionType": "single_choice",
        "required": true,
        "default": true
      },
      {
        "field": "confirmation",
        "questionType": "confirmation",
        "required": true
      }
    ],
    "freeTextFastPath": {
      "enabled": true,
      "skipAlreadyExtractedSteps": true,
      "minimumConfidence": 0.75
    }
  },
  "designRules": {
    "installationArea": {
      "mustExclude": [
        "стационарная мебель без вентиляционного зазора",
        "ванна и душевой поддон",
        "кухонный гарнитур",
        "встроенная техника",
        "перегородки",
        "тяжёлые предметы без вентиляционного зазора"
      ],
      "minimumFreeAirGapUnderFurnitureMm": 60,
      "requireExplicitInstallationArea": true
    },
    "heatingPurpose": {
      "comfort_floor": {
        "requiresHeatLossCalculation": false,
        "description": "Комфортная температура поверхности пола; не считается единственным источником отопления."
      },
      "additional_heating": {
        "requiresHeatLossCalculation": false,
        "description": "Дополнение к существующей системе отопления."
      },
      "main_heating": {
        "requiresHeatLossCalculation": true,
        "designMarginRange": [
          1.15,
          1.25
        ],
        "blockFinalMainHeatingClaimWithoutHeatLoss": true,
        "description": "Мощность определяется по расчётным теплопотерям помещения, а не только по площади."
      }
    },
    "installedPowerSelection": {
      "formula": "min(roomPresetTargetWm2, floorCovering.maxInstalledPowerWm2, selectedProduct.maxAllowedPowerWm2)",
      "rejectIfRequiredInstalledPowerExceedsCoveringLimit": true,
      "rejectIfMainHeatingPowerCannotCoverHeatLoss": true
    }
  },
