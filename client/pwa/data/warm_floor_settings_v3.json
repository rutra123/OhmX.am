    "theoreticalCableLengthFormula": "requiredTotalPowerW / selectedLinearPowerWm",
    "spacingFormulaCm": "installationAreaM2 * 100 / selectedProductCableLengthM",
    "actualInstalledPowerFormulaWm2": "selectedProductTotalPowerW / installationAreaM2",
    "designSpacingCm": {
      "minimum": 7.5,
      "maximum": 20,
      "hardMinimum": 5,
      "preferredMountingTapeSteps": [
        7.5,
        10,
        12.5,
        15,
        17.5,
        20
      ],
      "exactArrayMembershipRequired": false,
      "snapToNearestTapeStepIfWithinCm": 1.0
    },
    "factoryLengthRules": {
