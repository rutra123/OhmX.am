  "validationRules": {
    "roomAreaM2": {
      "min": 1,
      "max": 1000
    },
    "installationAreaM2": {
      "min": 0.5,
      "mustNotExceedField": "roomAreaM2",
      "error": "Площадь укладки не может быть больше площади помещения."
    },
    "targetPowerWm2": {
      "mustNotExceedCoveringLimit": true,
