        "термостат с датчиком пола",
        "DEVIreg",
        "OJ Electronics"
      ],
      "rejectGenericRoomThermostatWithoutFloorSensorInput": true
    },
    "floorSensor": {
      "requiredCapability": true,
      "separateProductRequiredIfNotIncludedWithThermostat": true,
      "avoidDuplicateIfIncluded": true,
      "accessoryGroup": "floor_sensor"
    },
    "sensorConduit": {
      "required": true,
      "accessoryGroup": "corrugated_tube",
      "allowManualLineItemIfNoCatalogProduct": true,
      "placement": {
        "betweenHeatingRuns": true,
        "distanceFromWallRangeCm": [
          50,
          100
        ],
        "sealedEndRequired": true,
        "replaceableSensorPathRequired": true
      }
    },
    "protection": {
      "required": true,
      "accessoryGroups": [
        "rcd",
        "rcbo",
        "circuit_breaker"
      ],
      "finalRatingRequiresElectrician": true
    },
    "mountingTape": {
      "requiredForSystemTypes": [
        "loose_cable"
      ],
      "notRequiredForSystemTypes": [
        "self_adhesive_mat"
      ],
      "accessoryGroup": "mounting_tape"
    },
    "thermalInsulation": {
      "conditional": true,
      "recommendedFor": [
        "main_heating",
        "balcony",
        "high_downward_heat_loss"
      ],
      "mustBeCompatibleWithFloorBuildUp": true,
      "mustMeetCompressiveStrengthRequirement": true,
      "doNotRecommendGenericFoilFoamAsUniversalSolution": true
    },
    "powerContactor": {
      "conditional": true,
      "accessoryGroup": "contactor",
      "condition": "actualCurrentA > selectedThermostat.maxResistiveLoadA OR actualCurrentA > selectedThermostat.maxResistiveLoadA * recommendedContactorUtilizationThreshold",
      "preferZoneSplitAlternative": true
    }
  },
