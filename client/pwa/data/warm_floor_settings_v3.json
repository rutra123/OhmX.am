    },
    "cableSpacingCm": {
      "warnBelow": 7.5,
      "hardRejectBelow": 5,
      "warnAbove": 20
    },
    "mainHeating": {
      "requiresHeatLossW": true,
      "blockProfessionalClaimWithoutHeatLoss": true
    },
    "mixedFloorCoverings": {
      "separateZonesRecommended": true,
      "separateThermostatOrIndependentLimitRequired": true
    }
  },
  "calculationRules": {
    "requiredTotalPowerW": {
      "comfortOrAdditional": "installationAreaM2 * targetInstalledPowerWm2",
      "mainHeating": "roomHeatLossW * selectedDesignMargin"
    },
    "requiredInstalledPowerWm2ForMainHeating": "requiredTotalPowerW / installationAreaM2",
    "theoreticalCableLengthM": "requiredTotalPowerW / selectedLinearPowerWm",
    "actualCableSpacingCm": "installationAreaM2 * 100 / selectedProductCableLengthM",
    "actualInstalledPowerWm2": "selectedProductTotalPowerW / installationAreaM2",
    "actualCurrentA": "selectedProductTotalPowerW / nominalVoltageV",
    "mountingTapeLengthM": "ceil(max(minimumLengthM, installationAreaM2 / rowSpacingM * wasteFactor))",
    "displayRounding": {
      "powerW": 0,
      "powerKw": 2,
      "currentA": 2,
      "cableLengthM": 1,
      "spacingCm": 1,
      "areaM2": 2
    },
    "engineeringRule": "Расчётная длина кабеля используется только для поиска ближайшего реального изделия фиксированной длины. Финальный шаг, мощность на м² и ток пересчитываются по фактическим данным выбранного товара."
  },
  "warnings": {
    "NO_SHORTEN_HEATING_ELEMENT": "Нагревательный элемент фиксированной мощности нельзя укорачивать или наращивать. Для мата допускается разрезать только сетку, не нагревательный кабель.",
    "NO_FIXED_FURNITURE": "Не укладывайте нагревательный элемент под стационарную мебель, ванну, кухонный гарнитур и технику без требуемого вентиляционного зазора.",
    "NO_CROSSING": "Нагревательные линии не должны пересекаться, касаться друг друга или укладываться внахлёст.",
    "CABLE_SPACING_OUT_OF_RANGE": "Полученный шаг укладки не соответствует допустимому диапазону выбранного изделия. Выберите другую заводскую мощность или длину кабеля.",
    "HEAT_LOSS_REQUIRED": "Для основного отопления обязателен отдельный расчёт теплопотерь. Подбор только по площади не подтверждает возможность полного отопления помещения.",
    "RCD_REQUIRED": "Контур должен быть защищён УЗО/дифзащитой с параметрами по паспорту изделия и местным нормам; для рассматриваемой конфигурации максимальный ток утечки устройства принят 30 мА.",
    "QUALIFIED_ELECTRICIAN_REQUIRED": "Подбор сечения линии, аппаратов защиты, контактора, подключение и измерения выполняет квалифицированный электрик.",
    "COVERING_LIMIT": "Требуемая установленная мощность или температура превышает лимит покрытия. Используйте паспорт покрытия как приоритетный источник.",
    "SPECIAL_DRY_SYSTEM_REQUIRED": "Для выбранного основания или покрытия требуется специальная система сухого монтажа; стандартный кабель или мат в клее/стяжке не подбирать.",
    "SENSOR_REQUIRED": "Датчик пола должен быть подключён к совместимому терморегулятору и установлен в заменяемой гофрированной трубке между нагревательными линиями.",
    "INSULATION_RECOMMENDED": "При основном отоплении, на балконе или при высоких потерях вниз нужна совместимая теплоизоляция с достаточной прочностью на сжатие.",
