    "scope": [
      "нагревательные кабели фиксированной длины",
      "нагревательные маты фиксированной площади",
      "терморегуляторы с датчиком пола",
      "защитная автоматика",
      "монтажные и обязательные аксессуары"
    ],
    "disclaimer": "Конфигурация предназначена для предварительного подбора. Окончательные теплотехнические и электрические решения, схема укладки, номиналы защиты и подключение должны быть подтверждены проектировщиком или квалифицированным электриком с учётом местных норм и паспортов выбранных изделий.",
    "sourcePolicy": {
      "manufacturerPassportOverridesConfig": true,
      "localElectricalCodeOverridesConfig": true,
      "doNotClaimRegulatoryComplianceFromConfigAlone": true
    }
  },
  "electricalSystem": {
