    "frequencyHz": 50,
    "phasesSupported": [
      "single_phase"
    ],
    "currentCalculation": {
      "formula": "actualTotalPowerW / nominalVoltageV",
      "displayDecimals": 2,
      "roundBeforeProtectionSelection": false
    }
  },
  "guidedFlow": {
    "intent": "floor_heating_selection",
    "steps": [
      {
        "field": "roomType",
        "questionType": "single_choice",
        "required": true
      },
      {
        "field": "roomAreaM2",
